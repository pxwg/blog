---
// src/pages/404.astro
import BaseHead from "$components/BaseHead.astro";
import Footer from "$components/Footer.astro";
import Header from "$components/Header.astro";
import { kSiteTitle, kSiteDescription, kUrlBase } from "$consts";
import { defaultLanguage, getLocalizedPagePath } from "$utils/i18n";

const aboutHref = getLocalizedPagePath("about", defaultLanguage, kUrlBase);
const homeHref = getLocalizedPagePath("home", defaultLanguage, kUrlBase);
---

<!doctype html>
<html lang={defaultLanguage} data-url-base={kUrlBase}>
  <head>
    <BaseHead title={"404 Not Found - " + kSiteTitle} description={kSiteDescription} />
    <style>
      .centered-404 {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        text-align: center;
      }
      .centered-404 a {
        margin: 0 0.5em;
        font-weight: bold;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="centered-404">
        <h1>404 - Page Not Found</h1>
        <p>In a place where no one is, inspiration is born.</p>
        <div>
          You can: <a href={aboutHref} class="accent" data-localized-route="about">Contact me</a> and share your thoughts.
        </div>
        <div>
          Or: <a href={homeHref} class="accent" data-localized-route="home">Return Home</a> and explore other content.
        </div>
      </section>
    </main>
    <Footer />
    <script>
      import { getCurrentLanguage, getLocalizedPagePath } from "$utils/i18n";

      const urlBase = document.documentElement.dataset.urlBase ?? "";
      const currentLang = getCurrentLanguage(window.location.pathname, urlBase);
      document.documentElement.lang = currentLang;

      document.querySelectorAll("[data-localized-route]").forEach((link) => {
        if (!(link instanceof HTMLAnchorElement)) return;

        const route = link.dataset.localizedRoute;
        if (route === "about" || route === "home") {
          link.setAttribute("href", getLocalizedPagePath(route, currentLang, urlBase));
        }
      });
    </script>
  </body>
</html>
